+# SequelBridge: also a static library, so the driver is built into the app rather
+# than downloaded when it connects. Same includes and MariaDB client as the
+# loadable one.
+build_static_extension(${TARGET_NAME} ${ALL_OBJECT_FILES})
+target_include_directories(${TARGET_NAME}_extension PRIVATE include ${MYSQL_INCLUDE_DIR})
+target_link_libraries(${TARGET_NAME}_extension ${MYSQL_LIBRARIES})
